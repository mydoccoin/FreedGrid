# Скопируй в .env и заполни своими значениями из Supabase → Project Settings → API.

# Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Публичный anon key (его можно показывать — он и так попадает в сборку)
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Необязательно: TURN-сервер для голосового чата в мобильных сетях.
# Без него используется только STUN Google.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=secret

# Optional public site URL used in Supabase confirmation / password reset emails.
# If empty: web uses the current origin, Android uses app.freedgrid.mobile://auth.
# VITE_SITE_URL=https://your-freedgrid-site.example

# Optional fallback: YooMoney wallet for paid tickets.
# Лучше указать кошелёк в админке → «оплата и письма» (таблица payment_settings).
# VITE_YOOMONEY_WALLET=410000000000000
